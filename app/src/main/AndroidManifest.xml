<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Required to drive the Glyph Matrix on Nothing devices. -->
    <uses-permission android:name="com.nothing.ketchum.permission.ENABLE" />

    <!-- Background monitoring runs as a foreground service. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.HIGH_SAMPLING_RATE_SENSORS" />

    <!-- This app is only meaningful on a device with a Glyph Matrix. -->
    <uses-feature
        android:name="android.hardware.sensor.accelerometer"
        android:required="true" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.ShakeTime">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Static launcher shortcut: long-press the app icon -> "Show time". -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!--
            Invisible trampoline that shows the time on the Glyph Matrix and
            immediately finishes. It is the target of the app shortcut and can be
            launched from automation apps such as Tasker:
              am start -n dev.orsetto.shaketime/.ShowTimeActivity
        -->
        <activity
            android:name=".ShowTimeActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.ShakeTime.Invisible" />

        <!--
            A second launcher entry that points at the trampoline. It gives a
            standalone "Show Time" icon that appears in launchers and, crucially,
            in automation apps' app pickers (e.g. Tasker → Launch App), so the
            reveal can be triggered with a single tap and no intent editing.
        -->
        <activity-alias
            android:name=".ShowTimeShortcut"
            android:targetActivity=".ShowTimeActivity"
            android:exported="true"
            android:icon="@drawable/ic_shake_time"
            android:label="@string/shortcut_launch_label">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!--
            Broadcast entry point for automation apps. From Tasker use
            "Send Intent" (Broadcast) with action:
              dev.orsetto.shaketime.action.SHOW_TIME
            or from a shell:
              am broadcast -a dev.orsetto.shaketime.action.SHOW_TIME \
                -n dev.orsetto.shaketime/.TriggerReceiver
        -->
        <receiver
            android:name=".TriggerReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="dev.orsetto.shaketime.action.SHOW_TIME" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!--
            Counts notifications for the Glyph binary indicator. Requires the
            user to grant Notification access in system settings.
        -->
        <service
            android:name=".NotificationCountService"
            android:label="@string/notif_listener_label"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <service
            android:name=".ShakeMonitorService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Detects a shake while the phone is face-down and briefly shows the time on the Glyph Matrix." />
        </service>

    </application>

</manifest>
